# ---------------------------------------------------------------------------
# Northline Air Care — environment variables
# Copy to .env.local and fill in. Nothing here is required for `npm run dev`;
# without an email provider the forms run in a clearly labelled dev mode and
# never claim a request was delivered.
# ---------------------------------------------------------------------------

# Public canonical URL (no trailing slash). Used for metadata, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email delivery (Resend) -------------------------------------------------
# Create an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
# Address the business receives booking + contact requests at.
BOOKING_TO_EMAIL=
# Verified sender, e.g. "Northline Air Care <bookings@yourdomain.com.au>"
BOOKING_FROM_EMAIL=

# --- Optional spam protection ------------------------------------------------
# Minimum seconds a human needs to fill the form (honeypot + timing check).
FORM_MIN_SECONDS=4
